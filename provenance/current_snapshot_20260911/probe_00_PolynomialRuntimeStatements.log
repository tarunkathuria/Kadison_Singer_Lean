theorem MatrixSpencer.KSFullPolynomialExplicit.algorithm : ∀ {N d : ℕ}
  (P : MatrixSpencer.KSPolynomialConvexSolver.PolynomialSolver) (v : Fin N → Fin d → ℂ)
  (hp : ∑ i, MatrixSpencer.KSRankOne.atom (v i) = 1) {ε : ℝ},
  0 ≤ ε →
    (∀ (i : Fin N), ‖MatrixSpencer.KSRankOne.atom (v i)‖ ≤ ε) →
      ∀ (r : ℕ),
        (∀ (z : MatrixSpencer.KSFullConvexOracleExplicit.Draws P.solver v hp r),
            ∃ cost draws,
              MatrixSpencer.KSFullPolynomialExplicit.Executes P v hp r z
                  (MatrixSpencer.KSFullConvexOracleExplicit.output P.solver v hp r z) cost draws ∧
                cost ≤ MatrixSpencer.KSFullPolynomialExplicit.totalCost P N d r ∧
                  draws ≤ r * MatrixSpencer.KSConvexQueryBudgets.fullHorizon N d) ∧
          (∀ (z : MatrixSpencer.KSFullConvexOracleExplicit.Draws P.solver v hp r) (σ : Fin N → ℝ),
              MatrixSpencer.KSFullConvexOracleExplicit.output P.solver v hp r z = some σ →
                (∀ (i : Fin N), MatrixSpencer.IsSign (σ i)) ∧
                  ‖∑ i, σ i • MatrixSpencer.KSRankOne.atom (v i)‖ ≤ 9 * (16 * √2 + 5) * √ε) ∧
            1 - (15 / 56) ^ r ≤
              ∑ z,
                MatrixSpencer.KSFullConvexOracleExplicit.drawWeight P.solver v hp r z *
                  if (MatrixSpencer.KSFullConvexOracleExplicit.output P.solver v hp r z).isSome = true then 1 else 0 :=
fun {N d} P v hp {ε} hε hsize r =>
  ⟨MatrixSpencer.KSFullPolynomialExplicit.exists_execution_bounded P v hp r,
    ⟨fun z σ hout => MatrixSpencer.KSFullConvexOracleExplicit.output_sound P.solver v hp hε hsize r z σ hout,
      MatrixSpencer.KSFullConvexOracleExplicit.output_event_probability_ge P.solver v hp r⟩⟩
